      ]
    },
    {
      "number": 2,
      "title": "先認識辭書形與四形",
      "intro": "辭書形是查字典的起點；同一個動詞，依表達需要改變形式。",
      "rule_ids": [
        "R-DICT-01"
      ],
      "wiki_pages": [
        "wiki/concepts/dictionary-form.md"
      ],
      "source_ids": [
        "S02",
