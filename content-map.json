      ]
    },
    {
      "number": 3,
      "title": "三類動詞，先分清楚",
      "intro": "分類決定規則。學單字時，把讀音、意思與類別一起記。",
      "rule_ids": [
        "R-CLASS-01",
        "R-CLASS-02"
      ],
      "wiki_pages": [
