        "S07"
      ]
    },
    {
      "number": 4,
      "title": "ます形：五段改い段",
      "intro": "最後的う段音改成同一行的い段音，再接ます。",
      "rule_ids": [
        "R-MASU-01"
      ],
      "wiki_pages": [
        "wiki/concepts/masu-form.md"
      ],
      "source_ids": [
        "S01",
        "S02",
        "S05"
      ]
    },
    {
      "number": 5,
      "title": "ます形：一段與變格",
      "intro": "一段去掉る；する、来る各自記。",
