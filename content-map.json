        "S05"
      ]
    },
    {
      "number": 7,
      "title": "ない形：一段、變格與ある",
      "intro": "先分類，再處理需要另外記憶的形式。",
      "rule_ids": [
        "R-NAI-02",
        "R-NAI-03"
      ],
      "wiki_pages": [
