        "S06"
      ]
    },
    {
      "number": 6,
      "title": "ない形：五段通常改あ段",
      "intro": "通常改成同一行的あ段音，再接ない。う結尾要改成わない。",
      "rule_ids": [
        "R-NAI-01"
      ],
      "wiki_pages": [
        "wiki/concepts/nai-form.md"
      ],
      "source_ids": [
